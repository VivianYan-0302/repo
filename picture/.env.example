# AI Provider 設定：mock | groq | watsonx | openai | gemini
AI_PROVIDER=mock

# Gemini（免費 tier，推薦）
# 申請：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq（免費，速度快）
# 申請：https://console.groq.com
GROQ_API_KEY=

# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# OpenAI
OPENAI_API_KEY=

# 伺服器埠號（預設 3000）
PORT=3000
