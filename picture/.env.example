# AI Provider 設定：mock | bob | groq | watsonx | openai | gemini
AI_PROVIDER=bob

# ── IBM Bob Inference API（推薦）────────────────────────────────────────────
# 取得方式：https://bob.ibm.com → 你的 instance → API Keys → 建立 Inference 類型 key
BOB_API_KEY=
# Inference endpoint（從 bob.ibm.com instance 頁面取得）
BOB_INFERENCE_URL=https://<your-instance>.bob.ibm.com/v1
# 可選：指定模型（從 /v1/models 列出可用模型），預設 claude-sonnet-4-5
# BOB_MODEL_ID=claude-sonnet-4-5

# ── IBM watsonx.ai ───────────────────────────────────────────────────────────
# 申請：https://dataplatform.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# 可選：指定模型，預設使用 ibm/granite-3-2-8b-instruct
# WATSONX_MODEL_ID=ibm/granite-3-2-8b-instruct

# Gemini（免費 tier）
# 申請：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq（免費，速度快）
# 申請：https://console.groq.com
GROQ_API_KEY=

# OpenAI
OPENAI_API_KEY=

# 伺服器埠號（預設 3000）
PORT=3000
